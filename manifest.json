{
  "manifest_version": 3,
  "name": "Claude Mascot",
  "version": "0.1.0",
  "description": "A little animated character that shows what Claude is doing — reading, writing, searching, testing — while you wait.",
  "permissions": [],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["mascot-states.js", "mascot-remote.js", "content.js"],
      "css": ["mascot.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
